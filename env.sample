# Секрет для подписи сессий better-auth.
# Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=change_me

# Публичный URL сайта (для прода — https://ваш-домен, без порта).
# От этого зависят cookie авторизации.
BETTER_AUTH_URL=https://neuromatic.cc

# Внешний порт на хосте (Caddy проксирует на 127.0.0.1:APP_PORT).
APP_PORT=3200

# --- SeaweedFS / S3 ---
# Host-порт S3 API (слушает только 127.0.0.1). Меняйте, если 8333 занят.
S3_PORT=8333
# Ключи доступа к S3. Сгенерировать: openssl rand -hex 16
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me
# Имя бакета для загружаемых файлов.
S3_BUCKET=razdevator
S3_REGION=us-east-1
# Endpoint S3. В docker-сети — по имени сервиса; для локального dev — http://localhost:8333
S3_ENDPOINT=http://seaweedfs:8333

# --- NanoGPT ---
# API-ключ провайдера (не коммитить; .env* в .gitignore).
NANOGPT_API_KEY=sk-nano-change_me
NANOGPT_BASE_URL=https://nano-gpt.com/api
NANOGPT_IMAGE_MODEL=qwen-image-2.1/edit-lora
NANOGPT_VIDEO_MODEL=bytedance/seedance-2.0/image-to-video-spicy

# --- Оплата (Exenta Pay, H2H API) ---
# Ключи из личного кабинета Exenta. Секрет — только на сервере.
PAYMENTS_PUBLIC_KEY=pk_change_me
PAYMENTS_SECRET_KEY=sk_change_me
# Секрет подписи вебхуков (личный кабинет → webhook secret).
# URL вебхука в кабинете: https://ваш-домен/api/payments/webhook
PAYMENTS_WEBHOOK_SECRET=change_me
# PAYMENTS_BASE_URL=https://exenta.pro/api/v1
